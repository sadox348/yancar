<?xml version="1.0"?>
<package format="3">
  <name>agv_task_controller</name>
  <version>1.0.0</version>
  <description>ROS 2 C++ point-goal controller demonstrating DDS QoS communication.</description>
  <maintainer email="yancar@todo.todo">yancar</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>stm32_base_bridge</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
